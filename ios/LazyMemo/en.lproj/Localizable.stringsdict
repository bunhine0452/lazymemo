<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@, 일정 %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld item</string>
			<key>other</key>
			<string>%2$lld items</string>
		</dict>
	</dict>
	<key>iCloud · %lld장</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>iCloud · %#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld note</string>
			<key>other</key>
			<string>%lld notes</string>
		</dict>
	</dict>
	<key>치워 둔 %lld장 도로 꺼내기</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Bring back %#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld retired note</string>
			<key>other</key>
			<string>%lld retired notes</string>
		</dict>
	</dict>
</dict>
</plist>
