# oculpm:begin v1
.oculpm/index/
.oculpm/hooks/
.oculpm/agents/live/
.oculpm/agents/inbox/
.oculpm/agents/tasks/
.oculpm/agents/leases/
.oculpm/agents/audit/
.oculpm/.lock
.oculpm/.schema-version
.oculpm/oculpm.log
.oculpm.backup-*/
# oculpm:end

# Swift / SPM
.build/
# .swiftpm 은 Xcode 의 개인 상태라 빼되, 공유 스킴(iOS 시뮬레이터에서 Core 를
# 시험하는 LazyMemoCoreTests)만 들여온다 — 부모가 빠지면 자식을 못 살리므로 층층이 연다.
.swiftpm/*
!.swiftpm/xcode/
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata/
.swiftpm/xcode/xcshareddata/*
!.swiftpm/xcode/xcshareddata/xcschemes/
Packages/
# iOS 앱의 프로젝트는 손으로 쓴 것이라 들여오고, Xcode 가 남기는 개인 상태만 뺀다.
*.xcodeproj
*.xcworkspace
!ios/LazyMemo.xcodeproj
ios/LazyMemo.xcodeproj/xcuserdata/
ios/LazyMemo.xcodeproj/project.xcworkspace/

# 빌드 산출물
dist/
build/
*.app/

# macOS
.DS_Store

# 세션 스크래치가 새어 들어온 자리 (렌더 임시 출력)
private/
